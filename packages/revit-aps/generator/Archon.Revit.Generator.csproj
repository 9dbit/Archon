<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Archon.Revit.Generator</AssemblyName>
    <RootNamespace>Archon.Revit.Generator</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="GeneratorHandler.cs" />
    <PackageReference Include="Autodesk.Forge.DesignAutomation.Revit" Version="2026.0.0"
                      GeneratePathProperty="true" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2026.0.0"
                      ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CopyDesignAutomationBridge" AfterTargets="Build">
    <PropertyGroup>
      <BridgeDll>$(PkgAutodesk_Forge_DesignAutomation_Revit)/lib/net8.0/DesignAutomationBridge.dll</BridgeDll>
    </PropertyGroup>
    <Error Condition="!Exists('$(BridgeDll)')" Text="REVIT_BRIDGE_RUNTIME_MISSING: $(BridgeDll)" />
    <Copy SourceFiles="$(BridgeDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
