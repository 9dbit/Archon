{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/autocad-plugin/worker.Dockerfile"
  },
  "deploy": {
    "startCommand": "node --experimental-transform-types packages/autocad-plugin/worker.mjs",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "NEVER"
  }
}
